# ===========================================================================
#  AutoTradeBot  —  copy this file to  .env  and fill in.  NEVER commit .env
# ===========================================================================
#
#  The app runs on Interactive Brokers: a running IB Gateway (or TWS) is the
#  login, the price feed for the scans and the built-in simulator, and - if
#  you choose - where orders go. Start the app and open Connections in the
#  dashboard: it edits the IBKR settings below for you. (Or edit by hand.)
#
#  Optional: record everything in MySQL instead of SQLite - fill in the DB_*
#  block and run:  python scripts/init_db.py
# ---------------------------------------------------------------------------

# What Paper trades on until the dashboard says otherwise:
#   ibkr      -> your IBKR paper account (IB Gateway logged in to the paper user)
#   simulator -> the built-in simulator, filled on IBKR's prices
PAPER_PLATFORM=ibkr

# Opening balance of the built-in simulator (also settable from the dashboard).
PAPER_START_CASH=100000
# PAPER_PERSIST=1                  # 0 = the simulator starts fresh every run

# ---- Interactive Brokers  (run:  python scripts/ibkr_setup.py --guide) ---
#  IBKR has NO API token and NO expiry. The API is a socket into a running
#  IB Gateway (or TWS); the login is the Gateway's, which IBKR restarts once
#  a day. Make that hands-off with IBC (IbcAlpha/IBC).
#
#  1. Client Portal -> Settings -> enable your PAPER account (username DU...).
#  2. IB Gateway -> Configure -> Settings -> API -> Settings:
#       Socket port 4002 (paper) / 4001 (live);  Trusted IP 127.0.0.1
#       untick "Read-Only API" so the bot can place orders
#       (older versions also have an "Enable ActiveX and Socket Clients" box to tick)
#     Configure -> Lock and Exit -> "Auto restart" (so it survives the
#     daily IBKR restart).
#  3. IBC: set IbLoginId / IbPassword / TradingMode=paper in its config.ini,
#     start it with StartGateway.bat (add a "run at logon" scheduled task).
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=4002              # IB Gateway paper  (TWS paper = 7497)
IBKR_LIVE_PORT=4001              # IB Gateway live   (TWS live  = 7496)
# IBKR_PORT=                      # non-zero forces ONE port for both accounts
IBKR_CLIENT_ID=11                # any int unique to this app on the Gateway
# IBKR_ACCOUNT_ID=DU1234567       # only if the login has several accounts
# IBKR_MARKET_DATA=auto           # auto | live | delayed | delayed-frozen
# IBKR_READONLY=0                 # 1 = connect for data only, never send orders

# ---- Database  (optional — SQLite is used automatically if this is blank) --
# DATABASE_URL=mysql+pymysql://autotradebot:password@127.0.0.1:3306/autotradebot
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autotradebot
DB_USER=autotradebot
DB_PASSWORD=
DB_ALLOW_SQLITE_FALLBACK=1         # set 0 in production so a DB outage is loud

# ---- Web dashboard --------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8787
OPEN_BROWSER_ON_START=1
