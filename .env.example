# ===========================================================================
#  tos-trader  —  copy this file to  .env  and fill in.  NEVER commit .env
# ===========================================================================
#
#  TIER 0 — run right now, zero setup
#     Leave everything below as-is. You get PAPER mode with a $100k simulated
#     account, filled against delayed yfinance data (or a synthetic feed if
#     yfinance isn't installed), and a local SQLite database.
#
#  TIER 1 — real-time data + the ability to flip the UI toggle to LIVE
#     Fill in the SCHWAB_* block and run:  python scripts/authenticate.py
#
#  TIER 2 — record everything in MySQL instead of SQLite
#     Fill in the DB_* block and run:  python scripts/init_db.py
# ---------------------------------------------------------------------------

# Which broker the app talks to.
#   paper  -> start in paper mode; the UI can still switch to LIVE_BROKER
#   ibkr / schwab -> start in live mode (needs that venue's block below)
BROKER=paper
LIVE_BROKER=ibkr                   # the venue the Paper/Live toggle targets: ibkr | schwab
                                   #   ibkr  -> paper mode routes to your IBKR PAPER account
                                   #   schwab-> paper mode uses the built-in simulator

# Opening balance of the built-in simulator (used only if the IBKR paper
# Gateway isn't reachable; also settable from the UI).
PAPER_START_CASH=100000

# ---- Interactive Brokers  (run:  python scripts/ibkr_setup.py --guide) ---
#  IBKR has NO API token and NO 60-day expiry. The API is a socket into a
#  running IB Gateway (or TWS); "auth" is the Gateway login, which IBKR
#  restarts once a day. Make that hands-off with IBC (IbcAlpha/IBC).
#
#  1. Client Portal -> Settings -> enable your PAPER account (username DU...).
#  2. IB Gateway -> Configure -> Settings -> API -> Settings:
#       [x] Enable ActiveX and Socket Clients
#       Socket port 4002 (paper) / 4001 (live);  Trusted IP 127.0.0.1
#       untick "Read-Only API" so the bot can place orders
#     Configure -> Lock and Exit -> "Auto restart" (so it survives the
#     daily IBKR restart).
#  3. IBC: set IbLoginId / IbPassword / TradingMode=paper in its config.ini,
#     start it with StartGateway.bat (add a "run at logon" scheduled task).
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=4002              # IB Gateway paper  (TWS paper = 7497)
IBKR_LIVE_PORT=4001              # IB Gateway live   (TWS live  = 7496)
# IBKR_PORT=                      # non-zero forces ONE port for both modes
IBKR_CLIENT_ID=11                # any int unique to this app on the Gateway
# IBKR_ACCOUNT_ID=DU1234567       # only if the login has several accounts
# IBKR_MARKET_DATA=auto           # auto | live | delayed | delayed-frozen
# IBKR_READONLY=0                 # 1 = connect for data only, never send orders

# ---- Schwab API  (alternative to IBKR;  https://developer.schwab.com) -----
#  1. Create an account, then an app. Request BOTH API products:
#       "Accounts and Trading Production"  and  "Market Data Production"
#  2. Set the app's callback URL to exactly:  https://127.0.0.1:8182
#  3. Wait for Schwab to approve the app (can take a few days).
#  4. Copy the App Key + Secret below.
#  5. Run:  pip install schwab-py  &&  python scripts/authenticate.py
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_ACCOUNT_ID=                 # your 8-digit brokerage account number

# ---- Legacy TD Ameritrade  (reference only — API decommissioned) ---------
TDA_API_KEY=
TDA_REDIRECT_URI=https://localhost:8182

# ---- OAuth token storage ------------------------------------------------
TOKEN_DIR=./secrets
# Optional: encrypt the token file at rest. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Database  (optional — SQLite is used automatically if this is blank) --
# DATABASE_URL=mysql+pymysql://tos:password@127.0.0.1:3306/tos_trader
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tos_trader
DB_USER=tos
DB_PASSWORD=
DB_ALLOW_SQLITE_FALLBACK=1         # set 0 in production so a DB outage is loud

# ---- Optional paid fundamentals --------------------------------------
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---- Web dashboard --------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8787
OPEN_BROWSER_ON_START=1
