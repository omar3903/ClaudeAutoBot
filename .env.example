# ===========================================================================
# tos-trader  --  copy to  .env  and fill in.  Never commit the real .env
# ===========================================================================

# ---- which broker adapter to use -------------------------------------------
# paper  | schwab | tda | ibkr | crypto
BROKER=paper

# ---- Schwab API (https://developer.schwab.com) ----------------------------
# Create an app, add https://127.0.0.1:8182 as an allowed callback URL.
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_ACCOUNT_ID=            # the plain account number; hashed value resolved at runtime

# ---- Legacy TD Ameritrade (reference only - API decommissioned) -----------
TDA_API_KEY=
TDA_REDIRECT_URI=https://localhost:8182

# ---- token storage -------------------------------------------------------
# Directory that holds the encrypted OAuth token + its key.
TOKEN_DIR=./secrets
# Fernet key used to encrypt the token file at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to auto-generate on first run and store in TOKEN_DIR/token_key.bin
TOKEN_ENCRYPTION_KEY=

# ---- MySQL --------------------------------------------------------------
# Full URL wins if set; otherwise the parts below are assembled.
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/tos_trader
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tos_trader
DB_USER=tos
DB_PASSWORD=
# Dev fallback if MySQL is unreachable (set to 1 to allow local sqlite):
DB_ALLOW_SQLITE_FALLBACK=1

# ---- optional paid fundamentals ---------------------------------------
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---- web dashboard ---------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8787
OPEN_BROWSER_ON_START=1
