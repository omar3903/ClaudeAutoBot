# ===========================================================================
#  tos-trader  —  copy this file to  .env  and fill in.  NEVER commit .env
# ===========================================================================
#
#  TIER 0 — run right now, zero setup
#     Leave everything below as-is. You get PAPER mode with a $100k simulated
#     account, filled against delayed yfinance data (or a synthetic feed if
#     yfinance isn't installed), and a local SQLite database.
#
#  TIER 1 — real-time data + the ability to flip the UI toggle to LIVE
#     Fill in the SCHWAB_* block and run:  python scripts/authenticate.py
#
#  TIER 2 — record everything in MySQL instead of SQLite
#     Fill in the DB_* block and run:  python scripts/init_db.py
# ---------------------------------------------------------------------------

# Which broker the app talks to.
#   paper  -> start in paper mode; the UI can still switch to LIVE_BROKER
#   schwab -> start in live mode (needs the SCHWAB_* block + a token)
BROKER=paper
LIVE_BROKER=schwab                 # the venue the Paper/Live toggle targets

# Opening balance of the paper account (also settable from the UI).
PAPER_START_CASH=100000

# ---- Schwab API  (https://developer.schwab.com) ---------------------------
#  1. Create an account, then an app. Request BOTH API products:
#       "Accounts and Trading Production"  and  "Market Data Production"
#  2. Set the app's callback URL to exactly:  https://127.0.0.1:8182
#  3. Wait for Schwab to approve the app (can take a few days).
#  4. Copy the App Key + Secret below.
#  5. Run:  pip install schwab-py  &&  python scripts/authenticate.py
SCHWAB_API_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_ACCOUNT_ID=                 # your 8-digit brokerage account number

# ---- Legacy TD Ameritrade  (reference only — API decommissioned) ---------
TDA_API_KEY=
TDA_REDIRECT_URI=https://localhost:8182

# ---- OAuth token storage ------------------------------------------------
TOKEN_DIR=./secrets
# Optional: encrypt the token file at rest. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Database  (optional — SQLite is used automatically if this is blank) --
# DATABASE_URL=mysql+pymysql://tos:password@127.0.0.1:3306/tos_trader
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tos_trader
DB_USER=tos
DB_PASSWORD=
DB_ALLOW_SQLITE_FALLBACK=1         # set 0 in production so a DB outage is loud

# ---- Optional paid fundamentals --------------------------------------
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---- Web dashboard --------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8787
OPEN_BROWSER_ON_START=1
